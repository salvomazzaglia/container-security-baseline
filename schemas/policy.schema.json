{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/salvomazzaglia/container-security-baseline/schemas/policy.schema.json",
  "title": "container-security-baseline policy",
  "description": "Policy profile aligned with config/*.policy.json and policy.load_policy.",
  "type": "object",
  "required": ["name"],
  "additionalProperties": false,
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "version": { "type": "string", "minLength": 1 },
    "fail_on": {
      "type": "string",
      "enum": ["Informational", "Low", "Medium", "High", "Critical"]
    },
    "minimum_score": { "type": "integer", "minimum": 0, "maximum": 100 },
    "enabled_rules": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "disabled_rules": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "severity_overrides": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "enum": ["Informational", "Low", "Medium", "High", "Critical"]
      }
    },
    "allow_critical_suppressions": { "type": "boolean" },
    "require_digest_pinning": { "type": "boolean" },
    "require_non_root": { "type": "boolean" },
    "require_read_only": { "type": "boolean" },
    "require_cap_drop_all": { "type": "boolean" },
    "require_no_new_privileges": { "type": "boolean" },
    "require_resource_limits": { "type": "boolean" },
    "require_pid_limit": { "type": "boolean" },
    "require_healthcheck": { "type": "boolean" },
    "require_bounded_logging": { "type": "boolean" },
    "disallow_wildcard_ports": { "type": "boolean" },
    "disallow_host_namespaces": { "type": "boolean" },
    "disallow_external_file_refs": { "type": "boolean" },
    "stateful_services": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "service_secret_expectations": {
      "type": "object",
      "additionalProperties": true
    },
    "backend_networks": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "scoring_deductions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "Critical": { "type": "integer", "minimum": 0 },
        "High": { "type": "integer", "minimum": 0 },
        "Medium": { "type": "integer", "minimum": 0 },
        "Low": { "type": "integer", "minimum": 0 },
        "Informational": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
