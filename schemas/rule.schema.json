{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/salvomazzaglia/container-security-baseline/schemas/rule.schema.json",
  "title": "container-security-baseline rules catalog",
  "description": "Rules file aligned with config/rules.json and models.RuleDefinition.",
  "type": "object",
  "required": ["rules"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "string", "minLength": 1 },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/rule" }
    }
  },
  "definitions": {
    "rule": {
      "type": "object",
      "required": [
        "id",
        "title",
        "target",
        "category",
        "severity",
        "summary",
        "risk",
        "remediation"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^CSB-(CMP|DF)-[0-9]{3}$"
        },
        "title": { "type": "string", "minLength": 1 },
        "target": {
          "type": "string",
          "enum": ["compose", "dockerfile", "project"]
        },
        "category": { "type": "string", "minLength": 1 },
        "severity": {
          "type": "string",
          "enum": ["Informational", "Low", "Medium", "High", "Critical"]
        },
        "summary": { "type": "string", "minLength": 1 },
        "risk": { "type": "string", "minLength": 1 },
        "remediation": { "type": "string", "minLength": 1 },
        "detailed_remediation": { "type": "string" },
        "references": {
          "type": "array",
          "items": { "type": "string" }
        },
        "enabled": { "type": "boolean" },
        "patchability": {
          "type": "string",
          "enum": ["safe", "manual", "unsupported", "ambiguous"]
        },
        "false_positives": { "type": "string" },
        "limitations": { "type": "string" },
        "detection_logic": { "type": "string" },
        "profiles": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["baseline", "strict", "development"]
          },
          "uniqueItems": true
        },
        "severity_overrides": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "enum": ["Informational", "Low", "Medium", "High", "Critical"]
          }
        }
      }
    }
  }
}
