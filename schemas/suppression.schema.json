{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/salvomazzaglia/container-security-baseline/schemas/suppression.schema.json",
  "title": "container-security-baseline suppressions",
  "description": "Suppressions file aligned with models.Suppression and config/suppressions.example.json.",
  "type": "object",
  "required": ["suppressions"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "string", "minLength": 1 },
    "suppressions": {
      "type": "array",
      "items": { "$ref": "#/definitions/suppression" }
    }
  },
  "definitions": {
    "suppression": {
      "type": "object",
      "required": [
        "id",
        "rule_id",
        "target",
        "justification",
        "owner_label",
        "created_at_utc",
        "expires_at_utc",
        "review_reference",
        "enabled"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "rule_id": { "type": "string", "minLength": 1 },
        "target": {
          "type": "string",
          "enum": ["compose", "dockerfile", "project"]
        },
        "justification": { "type": "string", "minLength": 1 },
        "owner_label": { "type": "string", "minLength": 1 },
        "created_at_utc": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "expires_at_utc": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "review_reference": { "type": "string", "minLength": 1 },
        "enabled": { "type": "boolean" },
        "property_path": { "type": ["string", "null"] },
        "fingerprint": { "type": ["string", "null"] },
        "service": { "type": ["string", "null"] }
      }
    }
  }
}
