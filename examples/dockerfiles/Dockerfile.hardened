# SYNTHETIC EXAMPLE — hardened Dockerfile patterns for demonstration.
# Do not build or run. Digest and registry are fake.

FROM registry.example.invalid/synthetic-app-build:1.2.3@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa AS builder

WORKDIR /src
COPY go.mod go.sum ./
RUN /usr/local/bin/synthetic-fetch-deps
COPY cmd/ ./cmd/
COPY internal/ ./internal/
RUN /usr/local/bin/synthetic-build -o /out/synthetic-app ./cmd/synthetic-app

FROM registry.example.invalid/synthetic-app-runtime:1.2.3@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa

WORKDIR /app
COPY --from=builder --chown=10001:10001 /out/synthetic-app /app/synthetic-app
COPY --chown=10001:10001 configs/app.toml /app/configs/app.toml

USER 10001:10001

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD ["/app/synthetic-app", "healthcheck"]

ENTRYPOINT ["/app/synthetic-app"]
CMD ["serve"]
