{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "container-security-baseline",
          "version": "1.0.0",
          "informationUri": "https://github.com/salvomazzaglia/container-security-baseline",
          "rules": [
            {
              "id": "CSB-CMP-001",
              "name": "privileged mode enabled",
              "shortDescription": {
                "text": "Service sets privileged: true."
              },
              "fullDescription": {
                "text": "Privileged mode significantly weakens container isolation and grants broad host access."
              },
              "help": {
                "text": "Set privileged: false or remove the field."
              },
              "properties": {
                "category": "Privilege",
                "severity": "Critical",
                "security-severity": "critical"
              }
            },
            {
              "id": "CSB-CMP-002",
              "name": "Docker/runtime socket mounted",
              "shortDescription": {
                "text": "A Docker/Podman runtime socket appears to be bind-mounted."
              },
              "fullDescription": {
                "text": "Mounting the runtime socket often equates to root-equivalent host control."
              },
              "help": {
                "text": "Do not mount docker.sock/podman.sock; use least-privilege APIs or socket proxies if required."
              },
              "properties": {
                "category": "Host access",
                "severity": "Critical",
                "security-severity": "critical"
              }
            },
            {
              "id": "CSB-CMP-003",
              "name": "Host root filesystem bind-mounted",
              "shortDescription": {
                "text": "Host root filesystem appears bind-mounted into the container."
              },
              "fullDescription": {
                "text": "Root bind mounts allow host filesystem compromise."
              },
              "help": {
                "text": "Remove root bind mounts; mount only required subpaths read-only when necessary."
              },
              "properties": {
                "category": "Host access",
                "severity": "Critical",
                "security-severity": "critical"
              }
            },
            {
              "id": "CSB-CMP-004",
              "name": "Sensitive host path mounted read-write",
              "shortDescription": {
                "text": "Sensitive host path mounted read-write."
              },
              "fullDescription": {
                "text": "Writable sensitive mounts can expose or alter host credentials and configuration."
              },
              "help": {
                "text": "Prefer read-only mounts or remove the mount; use named volumes for app data."
              },
              "properties": {
                "category": "Host access",
                "severity": "High",
                "security-severity": "high"
              }
            },
            {
              "id": "CSB-CMP-005",
              "name": "Sensitive host path mounted read-only",
              "shortDescription": {
                "text": "Sensitive host path mounted read-only."
              },
              "fullDescription": {
                "text": "Read-only sensitive mounts may still expose secrets or host metadata."
              },
              "help": {
                "text": "Avoid mounting sensitive host paths; use scoped files via secrets."
              },
              "properties": {
                "category": "Host access",
                "severity": "Medium",
                "security-severity": "medium"
              }
            },
            {
              "id": "CSB-CMP-006",
              "name": "network_mode host",
              "shortDescription": {
                "text": "Service uses network_mode: host."
              },
              "fullDescription": {
                "text": "Host networking removes network namespace isolation."
              },
              "help": {
                "text": "Use bridge/user-defined networks and publish only required ports."
              },
              "properties": {
                "category": "Isolation",
                "severity": "High",
                "security-severity": "high"
              }
            },
            {
              "id": "CSB-CMP-007",
              "name": "pid host namespace",
              "shortDescription": {
                "text": "Service uses pid: host."
              },
              "fullDescription": {
                "text": "Host PID namespace can enable process visibility and attack primitives."
              },
              "help": {
                "text": "Remove pid: host unless strictly required and suppressed with justification."
              },
              "properties": {
                "category": "Isolation",
                "severity": "Critical",
                "security-severity": "critical"
              }
            },
            {
              "id": "CSB-CMP-008",
              "name": "ipc host namespace",
              "shortDescription": {
                "text": "Service uses ipc: host."
              },
              "fullDescription": {
                "text": "Host IPC sharing weakens isolation between containers and host."
              },
              "help": {
                "text": "Avoid ipc: host; use private IPC or share only between required services."
              },
              "properties": {
                "category": "Isolation",
                "severity": "High",
                "security-severity": "high"
              }
            },
            {
              "id": "CSB-CMP-009",
              "name": "userns_mode host",
              "shortDescription": {
                "text": "User namespace isolation disabled or set to host."
              },
              "fullDescription": {
                "text": "Disabling user namespaces can map container root to host root."
              },
              "help": {
                "text": "Do not set userns_mode: host."
              },
              "properties": {
                "category": "Isolation",
                "severity": "High",
                "security-severity": "high"
              }
            },
            {
              "id": "CSB-CMP-010",
              "name": "device mappings present",
              "shortDescription": {
                "text": "Service maps host devices into the container."
              },
              "fullDescription": {
                "text": "Device access can allow low-level host interaction."
              },
              "help": {
                "text": "Map only required devices; prefer none."
              },
              "properties": {
                "category": "Host access",
                "severity": "High",
                "security-severity": "high"
              }
            },
            {
              "id": "CSB-CMP-011",
              "name": "broad device_cgroup_rules",
              "shortDescription": {
                "text": "Broad device cgroup rules detected."
              },
              "fullDescription": {
                "text": "Broad cgroup device rules can grant excessive device access."
              },
              "help": {
                "text": "Narrow device_cgroup_rules to the minimum required."
              },
              "properties": {
                "category": "Host access",
                "severity": "High",
                "security-severity": "high"
              }
            },
            {
              "id": "CSB-CMP-012",
              "name": "volumes_from used",
              "shortDescription": {
                "text": "volumes_from shares another container filesystem."
              },
              "fullDescription": {
                "text": "Inherited volumes may unexpectedly share sensitive data."
              },
              "help": {
                "text": "Declare explicit volumes instead of volumes_from."
              },
              "properties": {
                "category": "Filesystem",
                "severity": "Medium",
                "security-severity": "medium"
              }
            },
            {
              "id": "CSB-CMP-013",
              "name": "legacy links or external_links",
              "shortDescription": {
                "text": "Service uses links or external_links."
              },
              "fullDescription": {
                "text": "Legacy linking is obsolete and complicates network trust boundaries."
              },
              "help": {
                "text": "Use user-defined networks and service DNS names."
              },
              "properties": {
                "category": "Networking",
                "severity": "Low",
                "security-severity": "low"
              }
            },
            {
              "id": "CSB-CMP-020",
              "name": "cap_add ALL",
              "shortDescription": {
                "text": "Service adds ALL capabilities."
              },
              "fullDescription": {
                "text": "Adding ALL capabilities largely defeats capability-based least privilege."
              },
              "help": {
                "text": "Remove cap_add ALL; add only required capabilities."
              },
              "properties": {
                "category": "Capabilities",
                "severity": "Critical",
                "security-severity": "critical"
              }
            },
            {
              "id": "CSB-CMP-021",
              "name": "dangerous capabilities added",
              "shortDescription": {
                "text": "Dangerous Linux capabilities are added."
              },
              "fullDescription": {
                "text": "Dangerous capabilities can enable privilege escalation or host interaction."
              },
              "help": {
                "text": "Drop ALL and add only justified capabilities."
              },
              "properties": {
                "category": "Capabilities",
                "severity": "High",
                "security-severity": "high"
              }
            },
            {
              "id": "CSB-CMP-022",
              "name": "cap_drop missing",
              "shortDescription": {
                "text": "No cap_drop configured."
              },
              "fullDescription": {
                "text": "Without dropping capabilities, the default set may be broader than needed."
              },
              "help": {
                "text": "Add cap_drop: [ALL] and re-add only required capabilities."
              },
              "properties": {
                "category": "Capabilities",
                "severity": "Informational",
                "security-severity": "informational"
              }
            },
            {
              "id": "CSB-CMP-023",
              "name": "cap_drop does not include ALL",
              "shortDescription": {
                "text": "cap_drop is present but does not drop ALL."
              },
              "fullDescription": {
                "text": "Partial drops may leave dangerous capabilities."
              },
              "help": {
                "text": "Prefer cap_drop: [ALL]."
              },
              "properties": {
                "category": "Capabilities",
                "severity": "Low",
                "security-severity": "low"
              }
            },
            {
              "id": "CSB-CMP-024",
              "name": "seccomp unconfined",
              "shortDescription": {
                "text": "security_opt disables seccomp (seccomp=unconfined)."
              },
              "fullDescription": {
                "text": "Disabling seccomp removes an important syscall filter."
              },
              "help": {
                "text": "Remove seccomp=unconfined; use default or a tailored profile."
              },
              "properties": {
                "category": "Capabilities",
                "severity": "Critical",
                "security-severity": "critical"
              }
            },
            {
              "id": "CSB-CMP-025",
              "name": "AppArmor unconfined",
              "shortDescription": {
                "text": "AppArmor is explicitly unconfined."
              },
              "fullDescription": {
                "text": "Disabling AppArmor reduces mandatory access controls where available."
              },
              "help": {
                "text": "Remove apparmor:unconfined."
              },
              "properties": {
                "category": "Capabilities",
                "severity": "High",
                "security-severity": "high"
              }
            },
            {
              "id": "CSB-CMP-026",
              "name": "no-new-privileges missing",
              "shortDescription": {
                "text": "no-new-privileges is not enabled."
              },
              "fullDescription": {
                "text": "Without no-new-privileges, setuid binaries may escalate privileges."
              },
              "help": {
                "text": "Add security_opt: [no-new-privileges:true]."
              },
              "properties": {
                "category": "Capabilities",
                "severity": "Medium",
                "security-severity": "medium"
              }
            },
            {
              "id": "CSB-CMP-027",
              "name": "unsafe proc/sys mounts or sysctls",
              "shortDescription": {
                "text": "Writable proc/sys related mounts or unsafe sysctls detected."
              },
              "fullDescription": {
                "text": "Unsafe sysctls/mounts can affect host kernel behavior."
              },
              "help": {
                "text": "Remove unsafe sysctls and writable /proc|/sys mounts."
              },
              "properties": {
                "category": "Capabilities",
                "severity": "High",
                "security-severity": "high"
              }
            },
            {
              "id": "CSB-CMP-028",
              "name": "unsafe sysctl values",
              "shortDescription": {
                "text": "Sysctl values outside a conservative allowlist."
              },
              "fullDescription": {
                "text": "Non-default sysctls may weaken isolation; not all are insecure."
              },
              "help": {
                "text": "Review sysctls against an allowlist; remove unnecessary entries."
              },
              "properties": {
                "category": "Capabilities",
                "severity": "Medium",
                "security-severity": "medium"
              }
            },
            {
              "id": "CSB-CMP-030",
              "name": "no explicit service user",
              "shortDescription": {
                "text": "Service does not set user."
              },
              "fullDescription": {
                "text": "Containers often default to root inside the image user context."
              },
              "help": {
                "text": "Set an explicit non-root user."
              },
              "properties": {
                "category": "Identity",
                "severity": "Medium",
                "security-severity": "medium"
              }
            },
            {
              "id": "CSB-CMP-031",
              "name": "explicit root user",
              "shortDescription": {
                "text": "Service explicitly runs as root (user root or UID 0)."
              },
              "fullDescription": {
                "text": "Root inside the container increases impact of compromise."
              },
              "help": {
                "text": "Run as a non-root UID/GID."
              },
              "properties": {
                "category": "Identity",
                "severity": "High",
                "security-severity": "high"
              }
            },
            {
              "id": "CSB-CMP-032",
              "name": "privileged supplementary groups",
              "shortDescription": {
                "text": "group_add includes privileged/docker-like groups."
              },
              "fullDescription": {
                "text": "Supplementary privileged groups may grant host-equivalent access."
              },
              "help": {
                "text": "Remove privileged groups from group_add."
              },
              "properties": {
                "category": "Identity",
                "severity": "Medium",
                "security-severity": "medium"
              }
            },
            {
              "id": "CSB-CMP-033",
              "name": "credential dirs writable for root container",
              "shortDescription": {
                "text": "Writable home/credential mounts available to a root container."
              },
              "fullDescription": {
                "text": "Root plus writable credential mounts enables credential theft/modification."
              },
              "help": {
                "text": "Use read-only mounts and non-root users."
              },
              "properties": {
                "category": "Identity",
                "severity": "High",
                "security-severity": "high"
              }
            },
            {
              "id": "CSB-CMP-040",
              "name": "read_only not enabled",
              "shortDescription": {
                "text": "read_only root filesystem is not enabled."
              },
              "fullDescription": {
                "text": "Writable rootfs increases persistence options after compromise."
              },
              "help": {
                "text": "Set read_only: true and use tmpfs/volumes for writable paths."
              },
              "properties": {
                "category": "Filesystem",
                "severity": "Low",
                "security-severity": "low"
              }
            },
            {
              "id": "CSB-CMP-041",
              "name": "writable root filesystem undocumented",
              "shortDescription": {
                "text": "Writable root filesystem without documented need."
              },
              "fullDescription": {
                "text": "Writable rootfs may be unnecessary for many services."
              },
              "help": {
                "text": "Enable read_only when application-compatible."
              },
              "properties": {
                "category": "Filesystem",
                "severity": "Low",
                "security-severity": "low"
              }
            },
            {
              "id": "CSB-CMP-042",
              "name": "tmpfs advisory with read_only",
              "shortDescription": {
                "text": "read_only enabled; ensure tmpfs covers required writable paths."
              },
              "fullDescription": {
                "text": "Missing tmpfs may break apps or push writes to volumes unexpectedly."
              },
              "help": {
                "text": "Add explicit tmpfs for known writable runtime paths; do not invent paths."
              },
              "properties": {
                "category": "Filesystem",
                "severity": "Informational",
                "security-severity": "informational"
              }
            },
            {
              "id": "CSB-CMP-043",
              "name": "bind mount parent traversal",
              "shortDescription": {
                "text": "Bind mount source uses parent directory traversal."
              },
              "fullDescription": {
                "text": "Traversal can escape intended project directories."
              },
              "help": {
                "text": "Use paths within the project root only."
              },
              "properties": {
                "category": "Filesystem",
                "severity": "High",
                "security-severity": "high"
              }
            },
            {
              "id": "CSB-CMP-044",
              "name": "absolute host bind path",
              "shortDescription": {
                "text": "Absolute host bind path used."
              },
              "fullDescription": {
                "text": "Absolute binds couple config to host layout and may expose sensitive paths."
              },
              "help": {
                "text": "Prefer named volumes or project-relative binds when possible."
              },
              "properties": {
                "category": "Filesystem",
                "severity": "Informational",
                "security-severity": "informational"
              }
            },
            {
              "id": "CSB-CMP-045",
              "name": "bind source outside project root",
              "shortDescription": {
                "text": "Bind source appears outside the project root."
              },
              "fullDescription": {
                "text": "Out-of-tree binds expand the trust boundary."
              },
              "help": {
                "text": "Keep binds within the analyzed project root."
              },
              "properties": {
                "category": "Filesystem",
                "severity": "Medium",
                "security-severity": "medium"
              }
            },
            {
              "id": "CSB-CMP-046",
              "name": "ambiguous short volume syntax",
              "shortDescription": {
                "text": "Short volume syntax is ambiguous for analysis/patching."
              },
              "fullDescription": {
                "text": "Ambiguity increases review and remediation risk."
              },
              "help": {
                "text": "Prefer long syntax with explicit type/source/target/read_only."
              },
              "properties": {
                "category": "Filesystem",
                "severity": "Low",
                "security-severity": "low"
              }
            },
            {
              "id": "CSB-CMP-047",
              "name": "volume mode missing",
              "shortDescription": {
                "text": "Volume mode/read_only not specified."
              },
              "fullDescription": {
                "text": "Default may be writable; not always wrong for data volumes."
              },
              "help": {
                "text": "Set read_only explicitly when write access is unnecessary."
              },
              "properties": {
                "category": "Filesystem",
                "severity": "Informational",
                "security-severity": "informational"
              }
            },
            {
              "id": "CSB-CMP-050",
              "name": "secret-like environment literal",
              "shortDescription": {
                "text": "Likely secret embedded directly in environment."
              },
              "fullDescription": {
                "text": "Hard-coded secrets in Compose are frequently leaked via VCS and reports."
              },
              "help": {
                "text": "Use Compose secrets or an external secret manager; remove literals."
              },
              "properties": {
                "category": "Secrets",
                "severity": "Critical",
                "security-severity": "critical"
              }
            },
            {
              "id": "CSB-CMP-051",
              "name": "high-entropy credential literal",
              "shortDescription": {
                "text": "Likely high-entropy credential literal detected."
              },
              "fullDescription": {
                "text": "High-entropy literals often indicate tokens or keys."
              },
              "help": {
                "text": "Remove literals; inject secrets at runtime via a secret store."
              },
              "properties": {
                "category": "Secrets",
                "severity": "High",
                "security-severity": "high"
              }
            },
            {
              "id": "CSB-CMP-052",
              "name": "secret in command/entrypoint",
              "shortDescription": {
                "text": "Secret-like material appears in command or entrypoint."
              },
              "fullDescription": {
                "text": "Process arguments are widely visible in process listings."
              },
              "help": {
                "text": "Pass secrets via files/env from a secret store, not argv."
              },
              "properties": {
                "category": "Secrets",
                "severity": "High",
                "security-severity": "high"
              }
            },
            {
              "id": "CSB-CMP-053",
              "name": "secret in labels",
              "shortDescription": {
                "text": "Secret-like material appears in labels."
              },
              "fullDescription": {
                "text": "Labels are often exposed via inspect APIs and orchestration UIs."
              },
              "help": {
                "text": "Do not store secrets in labels."
              },
              "properties": {
                "category": "Secrets",
                "severity": "High",
                "security-severity": "high"
              }
            },
            {
              "id": "CSB-CMP-054",
              "name": "secret in build args",
              "shortDescription": {
                "text": "Secret-like build args detected."
              },
              "fullDescription": {
                "text": "Build args may persist in image history/cache metadata."
              },
              "help": {
                "text": "Use BuildKit secret mounts instead of ARG for secrets."
              },
              "properties": {
                "category": "Secrets",
                "severity": "High",
                "security-severity": "high"
              }
            },
            {
              "id": "CSB-CMP-055",
              "name": "env_file reference",
              "shortDescription": {
                "text": "env_file is referenced but not read by this analyzer."
              },
              "fullDescription": {
                "text": "File contents are outside verified scope and may contain secrets."
              },
              "help": {
                "text": "Ensure env_file is not committed; prefer secrets. Content was not read."
              },
              "properties": {
                "category": "Secrets",
                "severity": "Medium",
                "security-severity": "medium"
              }
            },
            {
              "id": "CSB-CMP-056",
              "name": "secret-like path as volume",
              "shortDescription": {
                "text": "Secret-like host path mounted as a normal volume."
              },
              "fullDescription": {
                "text": "Ordinary volumes lack Compose secret semantics and may be overly writable."
              },
              "help": {
                "text": "Use top-level secrets with explicit service grants."
              },
              "properties": {
                "category": "Secrets",
                "severity": "Medium",
                "security-severity": "medium"
              }
            },
            {
              "id": "CSB-CMP-057",
              "name": "top-level secret unused",
              "shortDescription": {
                "text": "Top-level secret declared but not granted to any service."
              },
              "fullDescription": {
                "text": "Unused secrets add complexity; may indicate misconfiguration."
              },
              "help": {
                "text": "Grant to required services or remove unused secret declarations."
              },
              "properties": {
                "category": "Secrets",
                "severity": "Informational",
                "security-severity": "informational"
              }
            },
            {
              "id": "CSB-CMP-058",
              "name": "service secret policy expectation",
              "shortDescription": {
                "text": "Service secret grant differs from explicit policy expectations."
              },
              "fullDescription": {
                "text": "Only evaluated when policy declares expectations."
              },
              "help": {
                "text": "Align service secrets with policy allowlists."
              },
              "properties": {
                "category": "Secrets",
                "severity": "Informational",
                "security-severity": "informational"
              }
            },
            {
              "id": "CSB-CMP-059",
              "name": "unsafe secret source path",
              "shortDescription": {
                "text": "Secret source path is absolute, traversing, or outside project root."
              },
              "fullDescription": {
                "text": "Unsafe secret paths expand trust boundaries."
              },
              "help": {
                "text": "Use project-relative secret files that are not tracked in VCS."
              },
              "properties": {
                "category": "Secrets",
                "severity": "Medium",
                "security-severity": "medium"
              }
            },
            {
              "id": "CSB-CMP-060",
              "name": "insecure interpolation default",
              "shortDescription": {
                "text": "Interpolation default looks like an insecure secret placeholder/literal."
              },
              "fullDescription": {
                "text": "Insecure defaults may become effective credentials."
              },
              "help": {
                "text": "Remove secret defaults; fail closed if unset."
              },
              "properties": {
                "category": "Secrets",
                "severity": "High",
                "security-severity": "high"
              }
            },
            {
              "id": "CSB-CMP-070",
              "name": "port published on all interfaces",
              "shortDescription": {
                "text": "Port published on wildcard interfaces (0.0.0.0/::)."
              },
              "fullDescription": {
                "text": "Wildcard binds may expose services beyond intended hosts."
              },
              "help": {
                "text": "Bind to 127.0.0.1 or a specific interface when possible."
              },
              "properties": {
                "category": "Networking",
                "severity": "Medium",
                "security-severity": "medium"
              }
            },
            {
              "id": "CSB-CMP-071",
              "name": "sensitive port published",
              "shortDescription": {
                "text": "Sensitive management/database port published."
              },
              "fullDescription": {
                "text": "Publishing admin/DB ports increases remote attack surface."
              },
              "help": {
                "text": "Do not publish sensitive ports; use internal networks or localhost binds."
              },
              "properties": {
                "category": "Networking",
                "severity": "High",
                "security-severity": "high"
              }
            },
            {
              "id": "CSB-CMP-072",
              "name": "host network with ports/privileges",
              "shortDescription": {
                "text": "Host networking combined with published ports or broad privileges."
              },
              "fullDescription": {
                "text": "Combined exposures compound isolation failure."
              },
              "help": {
