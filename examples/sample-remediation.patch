+# SYNTHETIC EXAMPLE — intentionally insecure for rule demonstration.
+# All hosts, registries, secrets, and service names are fake.
+# Do not run. Do not use in production.
+
+services:
+  synthetic-web:
+    image: registry.example.invalid/synthetic-web:latest
+    privileged: false
+    pid: host
+    network_mode: host
+    user: "0:0"
+    cap_add:
+      - ALL
+    security_opt:
+    - no-new-privileges:true
+      - seccomp:unconfined
+    volumes:
+      - /var/run/docker.sock:/var/run/docker.sock
+      - /etc:/etc
+    ports:
+      - "*:8080"
+    environment:
+      API_SECRET: [REDACTED]
+      DATABASE_PASSWORD: [REDACTED]
+    # Intentionally missing: deploy.resources, healthcheck, logging limits
+
+  synthetic-api:
+    image: registry.example.invalid/synthetic-api:latest
+    privileged: false
+    user: root
+    cap_add:
+      - SYS_ADMIN
+      - NET_ADMIN
+    volumes:
+      - /var/run/docker.sock:/var/run/docker.sock:ro
+      - /etc/passwd:[REDACTED]
+    ports:
+      - "*:3000"
+    environment:
+      TOKEN: [REDACTED]
+    logging:
+      driver: json-file
+      # Intentionally unbounded (no max-size / max-file)
+    cap_drop:
+      - ALL
+    security_opt:
+      - no-new-privileges:true
