{
  "name": "strict",
  "description": "Stronger least-privilege expectations for hardened deployments.",
  "version": "1.0.0",
  "fail_on": "Medium",
  "minimum_score": 70,
  "allow_critical_suppressions": false,
  "require_digest_pinning": true,
  "require_non_root": true,
  "require_read_only": true,
  "require_cap_drop_all": true,
  "require_no_new_privileges": true,
  "require_resource_limits": true,
  "require_pid_limit": true,
  "require_healthcheck": true,
  "require_bounded_logging": true,
  "disallow_wildcard_ports": true,
  "disallow_host_namespaces": true,
  "disallow_external_file_refs": true,
  "disabled_rules": [],
  "severity_overrides": {
    "CSB-CMP-040": "Medium",
    "CSB-CMP-022": "Low",
    "CSB-CMP-023": "Medium",
    "CSB-CMP-070": "High",
    "CSB-CMP-080": "Medium",
    "CSB-CMP-081": "Medium",
    "CSB-CMP-082": "Medium",
    "CSB-CMP-112": "Medium",
    "CSB-DF-003": "Medium",
    "CSB-DF-064": "Medium"
  },
  "stateful_services": [],
  "service_secret_expectations": {},
  "backend_networks": [],
  "scoring_deductions": {
    "Critical": 25,
    "High": 15,
    "Medium": 7,
    "Low": 2,
    "Informational": 0
  }
}
